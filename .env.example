# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real secrets.

# --- Kraken API credentials ---
# These are PATHS to the AES-256-GCM encrypted credential files created by
# `trading-bot credentials init` (and `... credentials init --futures`) -
# never put a raw Kraken API key/secret directly in this file.
#
# IMPORTANT: create the Spot/Margin key on kraken.com -> Settings -> API
# with ONLY "Query Funds", "Query Open & Closed Orders", and "Create &
# Modify Orders" permissions. Never grant "Withdraw Funds" to a key this
# bot holds - see README's Safety section for why.
KRAKEN_CREDENTIALS_PATH=./kraken.enc.json

# Only needed if [kraken].futures_pairs is non-empty in config.toml.
# Kraken recommends a separate API key per product; same permission rule
# applies (no Withdraw Funds).
KRAKEN_FUTURES_CREDENTIALS_PATH=./kraken_futures.enc.json

# --- Telegram alerts (optional) ---
# https://core.telegram.org/bots#how-do-i-create-a-bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
