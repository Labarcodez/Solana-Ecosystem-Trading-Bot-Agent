# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real secrets.

# --- Alchemy (free tier, 30M CU/month) ---
# https://dashboard.alchemy.com -> create a Solana Mainnet app
ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_WS_URL=wss://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# --- Shyft Yellowstone gRPC (free/unmetered streaming) ---
# https://shyft.to -> gRPC dashboard
SHYFT_GRPC_ENDPOINT=https://grpc.ny.shyft.to
SHYFT_X_TOKEN=YOUR_SHYFT_X_TOKEN

# --- Jito Block Engine (free to submit, tip paid in SOL on landing) ---
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# --- Wallet ---
# Path to the AES-256-GCM encrypted keypair file created by `wallet init`.
WALLET_KEY_PATH=./wallet.enc.json

# --- Telegram alerts (optional) ---
# https://core.telegram.org/bots#how-do-i-create-a-bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
